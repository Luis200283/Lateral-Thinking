# Pool Neon (runtime, @prisma/adapter-neon en @repo/db).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Directa Neon (migraciones, prisma.config.ts -> env("DIRECT_URL")).
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
PORT=4001
# Ambos frontends llaman a esta API: web :3000 y CMS :3001 (coma, sin espacios).
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
# Requerido en production (env.ts hace fail-fast); opcional en dev/test.
BETTER_AUTH_SECRET="cambia-esto-en-produccion"
BETTER_AUTH_URL="http://localhost:4001"

# --- Social login (OPCIONALES) ------------------------------------------------
# Si existen AMBAS credenciales del proveedor, betterAuth lo registra y el
# modal muestra su botón. Si faltan, el proveedor NO se monta y el botón no
# aparece. NUNCA rompen el build ni el login email/password.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Magic link por email (OPCIONAL) ------------------------------------------
# Sin RESEND_API_KEY la URL mágica se loguea en consola del servidor (modo dev).
# Con ella, se envía por email vía API de Resend (fetch, sin SDK).
RESEND_API_KEY=""
EMAIL_FROM="no-reply@luishswe.com"
